# =====================================================================
#  Cấu hình Docker Compose — copy thành .env rồi điền giá trị thật:
#     cp .env.example .env
#  Tạo chuỗi bí mật ngẫu nhiên:  openssl rand -hex 48
#  (hoặc: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
#  KHÔNG commit file .env lên Git.
# =====================================================================

# ---------- Cơ sở dữ liệu ----------
DB_NAME=quanlycuahang
DB_USER=app
DB_PASSWORD=doi-mat-khau-db-nay
MYSQL_ROOT_PASSWORD=doi-mat-khau-root-nay
# RAM cho MySQL (khuyến nghị 50–70% RAM của server, ví dụ 1G cho VPS 2GB)
MYSQL_BUFFER_POOL=256M

# ---------- Bảo mật JWT (mỗi chuỗi >= 32 ký tự, hai chuỗi PHẢI khác nhau) ----------
JWT_SECRET=thay-bang-chuoi-ngau-nhien-dai-it-nhat-32-ky-tu-1
JWT_REFRESH_TOKEN=thay-bang-chuoi-ngau-nhien-dai-it-nhat-32-ky-tu-2
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7

# ---------- Tài khoản Super Admin tạo lần đầu (>= 8 ký tự, có chữ và số) ----------
SUPER_ADMIN_USERNAME=admin
SUPER_ADMIN_PASSWORD=doi-mat-khau-admin-1

# ---------- Mạng ----------
# Cổng HTTP của giao diện khi chạy không có HTTPS (môi trường nội bộ / thử nghiệm)
WEB_PORT=80
# Production (docker-compose.prod.yml): tên miền đã trỏ DNS về server + email nhận thông báo chứng chỉ
DOMAIN=quanly.example.com
ACME_EMAIL=admin@example.com
# true khi chạy HTTPS (prod overlay tự bật). Để false khi thử nghiệm bằng http://localhost
COOKIE_SECURE=false
# Chỉ cần khi frontend chạy ở domain KHÁC với API (mặc định cùng domain qua Nginx → để trống)
CORS_ORIGINS=

# ---------- Hiệu năng & chống tấn công ----------
BACKEND_REPLICAS=2
DB_POOL_SIZE=20
RATE_LIMIT_API=600
RATE_LIMIT_LOGIN=10
LOGIN_MAX_FAILED=5
LOGIN_LOCK_MINUTES=15

# ---------- Sao lưu ----------
BACKUP_DIR=./backups
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=14
