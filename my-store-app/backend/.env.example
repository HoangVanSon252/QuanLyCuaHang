# Dùng khi chạy backend trực tiếp (npm run dev) không qua Docker.
# Khi chạy Docker, cấu hình nằm ở my-store-app/.env (xem .env.example ở thư mục đó).
PORT=8080
NODE_ENV=development

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=app
DB_PASSWORD=
DB_NAME=quanlycuahang
DB_POOL_SIZE=10
# DB_SSL=true   # bật khi dùng MySQL có yêu cầu SSL

# >= 32 ký tự, hai chuỗi khác nhau
JWT_SECRET=
JWT_REFRESH_TOKEN=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7

COOKIE_SECURE=false
# Khi chạy Vite dev server qua proxy (/api) thì để trống
CORS_ORIGINS=
TRUST_PROXY=1

SUPER_ADMIN_USERNAME=admin
SUPER_ADMIN_PASSWORD=
