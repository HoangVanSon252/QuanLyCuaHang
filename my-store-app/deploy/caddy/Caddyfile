{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip

	header {
		# Bắt buộc HTTPS trong 1 năm
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	# Caddy luôn ghi đè X-Forwarded-For bằng IP thật của người dùng
	reverse_proxy web:8080 {
		health_uri /healthz
		health_interval 15s
	}

	log {
		output stdout
		format json
	}
}
